{
  "kind": "collectionType",
  "collectionName": "sub_subcategories",
  "info": {
    "singularName": "sub-subcategory",
    "pluralName": "sub-subcategories",
    "displayName": "Sub-subcategory",
    "description": "An optional third level under a Subcategory, for branches of the catalog that need one (e.g. Вудилища → Поплавочні → Болонські)."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "image": {
      "type": "media",
      "allowedTypes": ["images"],
      "multiple": false
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "subcategory": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::subcategory.subcategory",
      "inversedBy": "subSubcategories"
    },
    "products": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::product.product",
      "mappedBy": "subSubcategory"
    }
  }
}
