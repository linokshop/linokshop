{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Товар",
    "description": "A ЛінОк catalog product."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "subcategory": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::subcategory.subcategory",
      "inversedBy": "products"
    },
    "subSubcategory": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::sub-subcategory.sub-subcategory",
      "inversedBy": "products"
    },
    "brand": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::brand.brand",
      "inversedBy": "products"
    },
    "oldPrice": {
      "type": "decimal"
    },
    "badge": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "badgeColor": {
      "type": "enumeration",
      "enum": ["bronze", "sale", "stock"],
      "default": "bronze"
    },
    "rating": {
      "type": "decimal"
    },
    "popularity": {
      "type": "integer",
      "default": 0
    },
    "recommended": {
      "type": "boolean",
      "default": false
    },
    "kasaCode": {
      "type": "string",
      "unique": true
    },
    "description": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultCkEditor"
      },
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "images": {
      "type": "media",
      "allowedTypes": ["images"],
      "multiple": true
    },
    "specs": {
      "type": "component",
      "component": "elements.spec-row",
      "repeatable": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "options": {
      "type": "component",
      "component": "utilities.text",
      "repeatable": true
    }
  }
}
