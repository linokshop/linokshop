{
  "kind": "collectionType",
  "collectionName": "attribute_values",
  "info": {
    "singularName": "attribute-value",
    "pluralName": "attribute-values",
    "displayName": "Attribute value",
    "description": "One option of an Attribute, e.g. 3.6 м for Довжина. Products link to these, which is what makes them filterable."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "attribute": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::attribute.attribute",
      "inversedBy": "values"
    },
    "products": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::product.product",
      "mappedBy": "attributeValues"
    }
  }
}
